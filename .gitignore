db.sqlite3
.env
media/
staticfiles/
__pycache__/
*.pyc

# Python bytecode
*.pyc
*.pyo
*.pyd
__pycache__/

# SQLite database and backups (local dev only; prod uses PostgreSQL)
db.sqlite3*

# Log files
*.log

# Environment files for sensitive keys
*.env
.env
# .env.* as well as *.env: the two patterns catch opposite ends. A tool that
# rewrites .env tends to save the old one beside it, and .env.bak slipped
# through every rule here — a file holding the live SECRET_KEY, database and
# gateway credentials, one `git add -A` away from a repo whose main branch
# deploys to production.
.env.*
# keep the template tracked
!.env.example

# Virtual environments
venv/
hitech_env/
henv/

# User-uploaded media and generated logs
media/
logs/

# collectstatic output - regenerated on deploy, not versioned
staticfiles/

# OS cruft
*.DS_Store
.DS_Store

# Claude Code local config
.claude/

# Angel instrument master cache (downloaded at runtime)
market_data/scrip_cache/

# JetBrains IDE settings (machine-local; includes device/emulator caches)
.idea/

# Built Android APKs — 70MB each, and rebuilt every release.
dist-apk/
*.apk
